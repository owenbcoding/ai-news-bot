DISCORD_TOKEN=your_discord_bot_token_here
# Discord text channel ID where AI news should be posted
CHANNEL_ID=123456789012345678
# Optional dedicated AI bot channel ID; falls back to CHANNEL_ID
AI_CHANNEL_ID=123456789012345678
# Optional: server (guild) ID for instant slash command sync
GUILD_ID=
# Daily posting times in UTC/GMT (twice a day at 9am and 5pm)
POST_TIMES_UTC=09:00,17:00
# Max articles to post per scheduled run
MAX_POSTS_PER_RUN=12
# Diversity: max items per source per scheduled run
MAX_PER_SOURCE_PER_RUN=3
# Optional: also post one plain-text digest after embeds
POST_TEXT_DIGEST=0
# Persistent storage paths
AI_ARCHIVE_PATH=state/ai_news_archive.jsonl
AI_DEDUPE_INDEX_PATH=state/ai_news_dedupe_index.json

